<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.ScoreMapper">
    
    <resultMap type="Score" id="ScoreResult">
        <result property="scoreId"    column="score_id"    />
        <result property="studentId"    column="student_id"    />
        <result property="courseId"    column="course_id"    />
        <result property="term"    column="term"    />
        <result property="usualScore"    column="usual_score"    />
        <result property="finalScore"    column="final_score"    />
        <result property="totalScore"    column="total_score"    />
        <result property="gpa"    column="gpa"    />
        <result property="manualTotal"    column="manual_total"    />
        <result property="recorderId"    column="recorder_id"    />
        <result property="recordTime"    column="record_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectScoreVo">
        select score_id, student_id, course_id, term, usual_score, final_score, total_score, gpa, manual_total, recorder_id, record_time, create_by, create_time, update_by, update_time, remark from edu_score
    </sql>

    <select id="selectScoreList" parameterType="Score" resultMap="ScoreResult">
        <include refid="selectScoreVo"/>
        <where>  
            <if test="studentId != null  and studentId != ''"> and student_id = #{studentId}</if>
            <if test="courseId != null  and courseId != ''"> and course_id = #{courseId}</if>
            <if test="term != null  and term != ''"> and term = #{term}</if>
        </where>
    </select>
    
    <select id="selectScoreByScoreId" parameterType="String" resultMap="ScoreResult">
        <include refid="selectScoreVo"/>
        where score_id = #{scoreId}
    </select>

    <insert id="insertScore" parameterType="Score">
        insert into edu_score
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="scoreId != null and scoreId != ''">score_id,</if>
            <if test="studentId != null and studentId != ''">student_id,</if>
            <if test="courseId != null and courseId != ''">course_id,</if>
            <if test="term != null and term != ''">term,</if>
            <if test="usualScore != null">usual_score,</if>
            <if test="finalScore != null">final_score,</if>
            <if test="totalScore != null">total_score,</if>
            <if test="gpa != null">gpa,</if>
            <if test="manualTotal != null">manual_total,</if>
            <if test="recorderId != null">recorder_id,</if>
            <if test="recordTime != null">record_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="scoreId != null and scoreId != ''">#{scoreId},</if>
            <if test="studentId != null and studentId != ''">#{studentId},</if>
            <if test="courseId != null and courseId != ''">#{courseId},</if>
            <if test="term != null and term != ''">#{term},</if>
            <if test="usualScore != null">#{usualScore},</if>
            <if test="finalScore != null">#{finalScore},</if>
            <if test="totalScore != null">#{totalScore},</if>
            <if test="gpa != null">#{gpa},</if>
            <if test="manualTotal != null">#{manualTotal},</if>
            <if test="recorderId != null">#{recorderId},</if>
            <if test="recordTime != null">#{recordTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateScore" parameterType="Score">
        update edu_score
        <trim prefix="SET" suffixOverrides=",">
            <if test="studentId != null and studentId != ''">student_id = #{studentId},</if>
            <if test="courseId != null and courseId != ''">course_id = #{courseId},</if>
            <if test="term != null and term != ''">term = #{term},</if>
            <if test="usualScore != null">usual_score = #{usualScore},</if>
            <if test="finalScore != null">final_score = #{finalScore},</if>
            <if test="totalScore != null">total_score = #{totalScore},</if>
            <if test="gpa != null">gpa = #{gpa},</if>
            <if test="manualTotal != null">manual_total = #{manualTotal},</if>
            <if test="recorderId != null">recorder_id = #{recorderId},</if>
            <if test="recordTime != null">record_time = #{recordTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where score_id = #{scoreId}
    </update>

    <delete id="deleteScoreByScoreId" parameterType="String">
        delete from edu_score where score_id = #{scoreId}
    </delete>

    <delete id="deleteScoreByScoreIds" parameterType="String">
        delete from edu_score where score_id in 
        <foreach item="scoreId" collection="array" open="(" separator="," close=")">
            #{scoreId}
        </foreach>
    </delete>
</mapper>