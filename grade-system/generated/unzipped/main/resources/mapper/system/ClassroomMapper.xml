<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.ClassroomMapper">
    
    <resultMap type="Classroom" id="ClassroomResult">
        <result property="classId"    column="class_id"    />
        <result property="className"    column="class_name"    />
        <result property="grade"    column="grade"    />
        <result property="headTeacherId"    column="head_teacher_id"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectClassroomVo">
        select class_id, class_name, grade, head_teacher_id, status, create_by, create_time, update_by, update_time, remark from edu_classroom
    </sql>

    <select id="selectClassroomList" parameterType="Classroom" resultMap="ClassroomResult">
        <include refid="selectClassroomVo"/>
        <where>  
            <if test="classId != null  and classId != ''"> and class_id = #{classId}</if>
            <if test="className != null  and className != ''"> and class_name like concat('%', #{className}, '%')</if>
        </where>
    </select>
    
    <select id="selectClassroomByClassId" parameterType="String" resultMap="ClassroomResult">
        <include refid="selectClassroomVo"/>
        where class_id = #{classId}
    </select>

    <insert id="insertClassroom" parameterType="Classroom">
        insert into edu_classroom
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="classId != null and classId != ''">class_id,</if>
            <if test="className != null and className != ''">class_name,</if>
            <if test="grade != null">grade,</if>
            <if test="headTeacherId != null">head_teacher_id,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="classId != null and classId != ''">#{classId},</if>
            <if test="className != null and className != ''">#{className},</if>
            <if test="grade != null">#{grade},</if>
            <if test="headTeacherId != null">#{headTeacherId},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateClassroom" parameterType="Classroom">
        update edu_classroom
        <trim prefix="SET" suffixOverrides=",">
            <if test="className != null and className != ''">class_name = #{className},</if>
            <if test="grade != null">grade = #{grade},</if>
            <if test="headTeacherId != null">head_teacher_id = #{headTeacherId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where class_id = #{classId}
    </update>

    <delete id="deleteClassroomByClassId" parameterType="String">
        delete from edu_classroom where class_id = #{classId}
    </delete>

    <delete id="deleteClassroomByClassIds" parameterType="String">
        delete from edu_classroom where class_id in 
        <foreach item="classId" collection="array" open="(" separator="," close=")">
            #{classId}
        </foreach>
    </delete>
</mapper>