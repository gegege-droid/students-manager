    <sql id="selectScoreChangeLogVo">
        select log_id, score_id, student_id, course_id, term, old_usual, old_final, old_total, new_usual, new_final, new_total, change_reason, operator_id, operate_time, source, create_by, create_time, update_by, update_time, remark from edu_score_change_log
    </sql>

    <select id="selectScoreChangeLogList" parameterType="ScoreChangeLog" resultMap="ScoreChangeLogResult">
        <include refid="selectScoreChangeLogVo"/>
        <where>  
            <if test="studentId != null  and studentId != ''"> and student_id = #{studentId}</if>
            <if test="courseId != null  and courseId != ''"> and course_id = #{courseId}</if>
            <if test="term != null  and term != ''"> and term = #{term}</if>
        </where>
    </select>
    
    <select id="selectScoreChangeLogByLogId" parameterType="String" resultMap="ScoreChangeLogResult">
        <include refid="selectScoreChangeLogVo"/>
        where log_id = #{logId}
    </select>

