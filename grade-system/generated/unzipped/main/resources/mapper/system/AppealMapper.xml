<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AppealMapper">
    
    <resultMap type="Appeal" id="AppealResult">
        <result property="appealId"    column="appeal_id"    />
        <result property="studentId"    column="student_id"    />
        <result property="courseId"    column="course_id"    />
        <result property="term"    column="term"    />
        <result property="originalScore"    column="original_score"    />
        <result property="reason"    column="reason"    />
        <result property="applyTime"    column="apply_time"    />
        <result property="status"    column="status"    />
        <result property="result"    column="result"    />
        <result property="correctedScore"    column="corrected_score"    />
        <result property="opinion"    column="opinion"    />
        <result property="handlerId"    column="handler_id"    />
        <result property="handleTime"    column="handle_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectAppealVo">
        select appeal_id, student_id, course_id, term, original_score, reason, apply_time, status, result, corrected_score, opinion, handler_id, handle_time, create_by, create_time, update_by, update_time, remark from edu_appeal
    </sql>

    <select id="selectAppealList" parameterType="Appeal" resultMap="AppealResult">
        <include refid="selectAppealVo"/>
        <where>  
            <if test="studentId != null  and studentId != ''"> and student_id = #{studentId}</if>
            <if test="courseId != null  and courseId != ''"> and course_id = #{courseId}</if>
            <if test="term != null  and term != ''"> and term = #{term}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectAppealByAppealId" parameterType="String" resultMap="AppealResult">
        <include refid="selectAppealVo"/>
        where appeal_id = #{appealId}
    </select>

    <insert id="insertAppeal" parameterType="Appeal">
        insert into edu_appeal
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="appealId != null and appealId != ''">appeal_id,</if>
            <if test="studentId != null and studentId != ''">student_id,</if>
            <if test="courseId != null and courseId != ''">course_id,</if>
            <if test="term != null and term != ''">term,</if>
            <if test="originalScore != null">original_score,</if>
            <if test="reason != null and reason != ''">reason,</if>
            <if test="applyTime != null">apply_time,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="result != null">result,</if>
            <if test="correctedScore != null">corrected_score,</if>
            <if test="opinion != null">opinion,</if>
            <if test="handlerId != null">handler_id,</if>
            <if test="handleTime != null">handle_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="appealId != null and appealId != ''">#{appealId},</if>
            <if test="studentId != null and studentId != ''">#{studentId},</if>
            <if test="courseId != null and courseId != ''">#{courseId},</if>
            <if test="term != null and term != ''">#{term},</if>
            <if test="originalScore != null">#{originalScore},</if>
            <if test="reason != null and reason != ''">#{reason},</if>
            <if test="applyTime != null">#{applyTime},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="result != null">#{result},</if>
            <if test="correctedScore != null">#{correctedScore},</if>
            <if test="opinion != null">#{opinion},</if>
            <if test="handlerId != null">#{handlerId},</if>
            <if test="handleTime != null">#{handleTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateAppeal" parameterType="Appeal">
        update edu_appeal
        <trim prefix="SET" suffixOverrides=",">
            <if test="studentId != null and studentId != ''">student_id = #{studentId},</if>
            <if test="courseId != null and courseId != ''">course_id = #{courseId},</if>
            <if test="term != null and term != ''">term = #{term},</if>
            <if test="originalScore != null">original_score = #{originalScore},</if>
            <if test="reason != null and reason != ''">reason = #{reason},</if>
            <if test="applyTime != null">apply_time = #{applyTime},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="result != null">result = #{result},</if>
            <if test="correctedScore != null">corrected_score = #{correctedScore},</if>
            <if test="opinion != null">opinion = #{opinion},</if>
            <if test="handlerId != null">handler_id = #{handlerId},</if>
            <if test="handleTime != null">handle_time = #{handleTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where appeal_id = #{appealId}
    </update>

    <delete id="deleteAppealByAppealId" parameterType="String">
        delete from edu_appeal where appeal_id = #{appealId}
    </delete>

    <delete id="deleteAppealByAppealIds" parameterType="String">
        delete from edu_appeal where appeal_id in 
        <foreach item="appealId" collection="array" open="(" separator="," close=")">
            #{appealId}
        </foreach>
    </delete>
</mapper>